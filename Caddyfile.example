# Optional: HTTP on 8080 → redirect to HTTPS:8443
# http://mulroy.localhost:8080 {
#  redir https://mulroy.localhost:8443{uri}
# }

# Main site over HTTPS on 8447 using your mkcert files
https://mulroy.localhost:8447 {
  tls /etc/caddy/certs/mulroy.localhost.pem /etc/caddy/certs/mulroy.localhost-key.pem
  encode zstd gzip

  # --- Uploads routing from production server ---
  # Everything under uploads (match all medial)
  # @remoteUploads path /wp-content/uploads/*

  # Proxy uploads to production
  # handle @remoteUploads {
    # Optional: allow <img> hotlinking to work from your dev pages
    # (not needed for plain <img>, but helpful for JS fetch/CORS)
    # header Access-Control-Allow-Origin *

  #  reverse_proxy https://mulroygroup.com {
  #    # Make upstream treat it as first-party
  #    header_up Host mulroygroup.com
  #    header_up X-Forwarded-Host {host}
  #    header_up X-Forwarded-Proto https
  #    # Strip any referrer to avoid hotlink rules
  #    header_up -Referer
  #  }
  # }

  # Everything else → local WordPress
  reverse_proxy wordpress:80
}
